                  "  pm.expect(session.status).to.eql('COMPLETED');",
                  "  pm.expect(session.completedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete session — already completed (409)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
