                ]
              }
            }
          ]
        },
        {
          "name": "Complete session — malformed id (400)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/not-an-id/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "not-an-id", "complete"]
            },
            "description": "`not-an-id` isn't a 24-char hex ObjectId. Expect `400 VALIDATION_ERROR` with `details[0].path = \"id\"`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Teachers' sessions: create, list available for a day, book, complete. Needs the `teacherId` collection variable (from `npm run seed`)."
    },
