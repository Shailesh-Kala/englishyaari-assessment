                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code USER_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('USER_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ],
      "description": "A user's history: `upcoming` and `completed`. Built with a MongoDB aggregation pipeline (`$facet`)."
    }
  ]
