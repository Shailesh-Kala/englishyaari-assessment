{
  "info": {
    "name": "EnglishYaari Session Booking API",
    "description": "Run top to bottom (Collection Runner works).\n\n1. `docker compose up -d --wait`, `npm run seed`, `npm run dev`.\n2. Paste one teacher id from the seed output into the `teacherId` collection variable.\n\n`userId` and `sessionId` are set automatically by the test scripts. Each run uses a fresh email and a random future slot, so re-running doesn't collide with earlier data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "startTime",
      "value": ""
    },
    {
      "key": "endTime",
      "value": ""
    },
    {
      "key": "dateTimestamp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('db up', () => pm.expect(pm.response.json().db).to.eql('up'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+91 98765 43210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('email', `asha.${Date.now()}@example.com`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test('phone normalised', () => pm.expect(user.phone).to.eql('+919876543210'));",
                  "pm.collectionVariables.set('userId', user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user — duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha R\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"9876543211\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code EMAIL_ALREADY_EXISTS', () => pm.expect(pm.response.json().error.code).to.eql('EMAIL_ALREADY_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user — invalid body (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('lists each bad field', () => pm.expect(pm.response.json().error.details).to.have.length(3));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('teacherId')) {",
                  "  throw new Error('Set the teacherId collection variable to an id printed by `npm run seed`.');",
                  "}",
                  "// Random future day + current minute, so repeated runs don't overlap earlier ones.",
                  "const MINUTE = 60 * 1000, DAY = 24 * 60 * MINUTE;",
                  "const days = 1 + Math.floor(Math.random() * 3650);",
                  "const start = Math.floor((Date.now() + days * DAY) / MINUTE) * MINUTE;",
                  "pm.collectionVariables.set('startTime', new Date(start).toISOString());",
                  "pm.collectionVariables.set('endTime', new Date(start + 60 * MINUTE).toISOString());",
                  "pm.collectionVariables.set('dateTimestamp', String(start));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const session = pm.response.json();",
                  "pm.test('starts AVAILABLE', () => pm.expect(session.status).to.eql('AVAILABLE'));",
                  "pm.collectionVariables.set('sessionId', session._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create session — overlapping (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code SESSION_OVERLAP', () => pm.expect(pm.response.json().error.code).to.eql('SESSION_OVERLAP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create session — endTime before startTime (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{endTime}}\",\n  \"endTime\": \"{{startTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create session — unknown teacher (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"0000000000000000000000ff\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code TEACHER_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('TEACHER_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Available sessions for date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map((s) => s._id);",
                  "pm.test('includes the new session', () => pm.expect(ids).to.include(pm.collectionVariables.get('sessionId')));",
                  "pm.test('includes teacher info', () => pm.expect(pm.response.json()[0].teacher).to.have.keys('_id', 'fullName', 'specialization'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Available sessions — missing dateTimestamp (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Book session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "book"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const session = pm.response.json();",
                  "pm.test('BOOKED for the user', () => {",
                  "  pm.expect(session.status).to.eql('BOOKED');",
                  "  pm.expect(session.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Book session — already booked (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "book"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code SESSION_NOT_AVAILABLE', () => pm.expect(pm.response.json().error.code).to.eql('SESSION_NOT_AVAILABLE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Book session — unknown user (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "book"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"0000000000000000000000ff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code USER_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('USER_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "User sessions — booked shows as upcoming",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "sessions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const { upcoming, completed } = pm.response.json();",
                  "pm.test('session is upcoming', () => pm.expect(upcoming.map((s) => s._id)).to.include(pm.collectionVariables.get('sessionId')));",
                  "pm.test('nothing completed yet', () => pm.expect(completed).to.have.length(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete session",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const session = pm.response.json();",
                  "pm.test('COMPLETED with completedAt', () => {",
                  "  pm.expect(session.status).to.eql('COMPLETED');",
                  "  pm.expect(session.completedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete session — already completed (409)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code SESSION_NOT_BOOKED', () => pm.expect(pm.response.json().error.code).to.eql('SESSION_NOT_BOOKED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete session — malformed id (400)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/not-an-id/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "not-an-id", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User sessions",
      "item": [
        {
          "name": "User sessions — completed shows in history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "sessions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const { upcoming, completed } = pm.response.json();",
                  "const id = pm.collectionVariables.get('sessionId');",
                  "pm.test('moved to completed', () => {",
                  "  pm.expect(completed.map((s) => s._id)).to.include(id);",
                  "  pm.expect(upcoming.map((s) => s._id)).to.not.include(id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "User sessions — unknown user (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/0000000000000000000000ff/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", "0000000000000000000000ff", "sessions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code USER_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('USER_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
