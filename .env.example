NODE_ENV=development
PORT=3000
# Must point at a replica set (transactions). docker compose up -d gives you one.
MONGODB_URI=mongodb://localhost:27017/englishyaari?directConnection=true
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (empty = none; Postman/curl are unaffected).
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
